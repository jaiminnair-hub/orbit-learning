              "a11y": { "altText": "Ground floor plan showing the marked evacuation route to the north exit" }
            },
            {
              "id": "walker",
              "type": "image",
              "assetId": "2c9e4a71-7b3d-4e51-9a6f-3d5e71b3d4e5",
