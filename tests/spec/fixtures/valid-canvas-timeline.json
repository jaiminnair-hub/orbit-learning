{
  "specSchemaVersion": "1.0.0",
  "meta": {
    "title": "Evacuation Route Walkthrough",
    "locale": "en",
    "accessibilityProfile": "wcag-2.2-aa"
  },
  "variables": [
    { "id": "routeSeen", "name": "Route seen", "type": "boolean", "scope": "course", "initial": false }
  ],
  "sections": [
    {
