                ]
              },
              {
                "blockId": "walker",
                "appearAtMs": 2000,
                "animations": [
                  {
                    "id": "walk-path",
                    "kind": "motion",
                    "startMs": 2000,
                    "durationMs": 8000,
                    "easing": "linear",
                    "path": {
                      "kind": "polyline",
                      "points": [
                        { "x": 120, "y": 560 },
                        { "x": 470, "y": 560 },
                        { "x": 470, "y": 220 },
                        { "x": 980, "y": 220 }
                      ],
                      "orientToPath": true
                    }
                  }
                ]
              }
            ]
          },
          "blocks": [
            {
              "id": "floor-image",
              "type": "image",
              "assetId": "6f1d3c62-9a1b-4c8e-8f2a-1b4c8e9a1b4c",
