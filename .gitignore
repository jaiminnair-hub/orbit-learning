# dependencies
/node_modules
apps/*/node_modules

# local QA/verification output (scripts/qa/*, ad-hoc conformance runs)
/artifacts/

# next.js
/.next/
/.next-qa/
/.next-qa-debug/
/.next-qa-background/
/out/
apps/*/.next/
apps/*/next-env.d.ts

# cloudflare / opennext
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# production
/build

# env — never commit real secrets
.env
.env.local
.env.*.local
# wrangler/workerd local runtime vars — same rule
.dev.vars
.dev.vars.*

# misc
tsconfig.tsbuildinfo
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
next-env.d.ts
.vscode/
.idea/

# wrangler-generated runtime types for the standalone workers in spikes/ —
# ~570KB of generated declarations, regenerated by `npm run typecheck:jobs`
spikes/**/worker-configuration.d.ts
spikes/**/.wrangler/

# built export-conformance packages — regenerated by
# `npx vitest run tests/export/export-conformance.test.ts`
spikes/export-conformance/output/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.auth/

# throwaway proof artifacts, not source
.tmp-pipeline-packages/

.vercel
.env*
artifacts/qa/

# keep the documented example files
!.env.example
!**/.env.example
