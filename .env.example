# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.
# Use a dedicated Supabase project for this app.

# Project Settings -> API in the Supabase dashboard ("Get Connected" panel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never exposed to the browser, never prefixed NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Origin auth actions build email confirmation/reset links from
# (lib/auth/actions.ts). Must match this build's real deployment origin —
# a build without this set falls back to http://localhost:3000, breaking
# email confirmation and password reset in any non-local build. On
# Vercel, set this per-environment (production vs. a staging deployment
# have different values) rather than once for the whole project.
NEXT_PUBLIC_SITE_URL=

# Optional. The AI gateway (lib/ai/gateway.ts) has never been exercised
# against a real provider — everything so far has run against the
# deterministic in-process adapter. Leave unset until that's a deliberate
# decision, not an accident of an env var existing.
ANTHROPIC_API_KEY=
# Optional. AICredits (https://aicredits.in) — an INR-billed gateway used as
# the primary AI provider (lib/ai/profiles.ts tries this before a direct
# Anthropic key) and the required embeddings provider for Orbit Guide.
# Get a key from the AICredits dashboard; it is unrelated to
# ANTHROPIC_API_KEY above and both may be set at once.
AICREDITS_API_KEY=
AI_MONTHLY_BUDGET_USD=

# Optional. Rate limiting (lib/ratelimit.ts) fails open when either is
# missing — true in every environment today. See
# docs/RATE_LIMITING_SETUP.md before treating rate limiting as active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, and load-bearing when set: leave NEXT_PUBLIC_SCORM_CONTENT_ORIGIN
# unset to keep the SCORM player on its current same-origin path. Setting
# it switches learners onto the isolated content-origin bridge
# (docs/SCORM_CONTENT_ISOLATION_ARCHITECTURE.md) — do not set this in any
# real environment until a genuinely separate Vercel project exists for
# apps/scorm-content, both SCORM_BRIDGE_TOKEN_SECRET and
# CONTENT_BRIDGE_SECRET are configured identically on both projects, and
# a staging smoke test of launch/resume/completion/score has passed
# through the isolated path specifically.
NEXT_PUBLIC_SCORM_CONTENT_ORIGIN=
# Shared with apps/scorm-content's own env — generate with e.g.
# `openssl rand -hex 32`. Two distinct secrets, not the same value twice.
SCORM_BRIDGE_TOKEN_SECRET=
CONTENT_BRIDGE_SECRET=

# Required for xAPI/Tin Can ingest (docs/XAPI_INGEST_ARCHITECTURE.md) — signs
# the launch credential an ingested package's own JS sends as its
# `Authorization: Basic` header to app/api/v1/xapi-lrs/. Single project only,
# unlike the SCORM secrets above: xAPI content never needs a second
# deployment. Generate with e.g. `openssl rand -hex 32`.
XAPI_LRS_TOKEN_SECRET=

# Optional. Single-operator role switcher: lets exactly one account genuinely
# switch its own role inside one organisation (handy for demos and QA).
# Both must be set for the switcher to appear. Leave unset to disable.
ROLE_SWITCH_EMAIL=
ROLE_SWITCH_ORG_SLUG=

# Optional. If the app is served through one public "front door" domain in
# front of a raw Vercel domain, set it here (production redirects to it).
FRONT_DOOR_HOST=

# Optional. Lets the Platform Control page dispatch the QA workflow
# (.github/workflows/orbit-qa.yml). Format: "owner/repo" plus a token with
# actions:write on that repo.
GITHUB_QA_REPOSITORY=
GITHUB_QA_DISPATCH_TOKEN=
