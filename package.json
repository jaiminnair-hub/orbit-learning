{
  "name": "orbit-learning",
  "version": "0.1.0",
  "description": "Free, open-source learning platform: course authoring, SCORM/xAPI/cmi5, assessments, certificates, skills and 360-degree feedback.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-no-static-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:jobs": "cd spikes/job-execution && wrangler types && tsc --noEmit",
    "test": "supabase start --ignore-health-check && vitest run",
    "test:e2e": "supabase start --ignore-health-check && playwright test",
    "qa:personas": "supabase start --ignore-health-check && node scripts/qa/run-persona-qa.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "verify:demo": "node scripts/verify-demo-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/functions": "^3.9.5",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "undici": "^7.29.1",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
