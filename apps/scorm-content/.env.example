# This app holds no Supabase credential of any kind, by design — see
# docs/SCORM_CONTENT_ISOLATION_ARCHITECTURE.md. Everything below is the
# entire environment surface it needs.

# The main app's real deployed URL (its own domain, not this one).
APP_ORIGIN=

# Must be the exact same two values configured on the main app's
# SCORM_BRIDGE_TOKEN_SECRET and CONTENT_BRIDGE_SECRET — these are shared
# secrets across both deployments, not independently generated per app.
SCORM_BRIDGE_TOKEN_SECRET=
CONTENT_BRIDGE_SECRET=
